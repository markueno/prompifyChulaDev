# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Prompify — environment variable reference                              ║
# ║  Copy this file:  cp .env.example .env                                  ║
# ║  Never commit the real .env — it contains secrets.                      ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://www.prompify.com
PORT=5173

# ── Billing (Stripe) ───────────────────────────────────────────────────────────
# Billing is inert until STRIPE_SECRET_KEY is set: /api/billing/checkout returns 503 and the
# pricing page falls back to "not configured". Use sk_test_/price_ test values first — the
# webhook secret differs between test mode and live mode, so it must be swapped too.
#
# NOTE: there is no STRIPE_PUBLISHABLE_KEY here on purpose. Checkout is a server-side redirect
# (see stripe.server.ts), so no client-side key is used anywhere in the app.
STRIPE_SECRET_KEY=
# From `stripe listen` in test mode, or the endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (price_...). Only the tiers you set here can be purchased.
# Builder is the $8/mo plan — if someone hands you "STRIPE_PRICE_PRO_MONTHLY", it is this one.
STRIPE_PRICE_BUILDER_MONTHLY=
STRIPE_PRICE_BUILDER_ANNUAL=
STRIPE_PRICE_INNOVATOR_MONTHLY=
STRIPE_PRICE_INNOVATOR_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
# One-off 1M-token top-up pack any paid plan can buy.

# ── Auth ───────────────────────────────────────────────────────────────────────
# Set to true ONLY for local dev / emergency access — never in production
AUTH_DISABLED=false

# Long random string — generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Require email verification on sign-up
EMAIL_VERIFICATION_REQUIRED=true

# ── Prompify PostgreSQL (main app database) ────────────────────────────────────
# This is the database Prompify itself uses (users, chats, sessions, etc.)
# It is NOT the per-app Supabase database below.
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/prompify

# Raw credentials (used by Docker Compose for the Prompify DB container)
POSTGRES_DB=prompify
POSTGRES_USER=prompify_user
POSTGRES_PASSWORD=change_me_strong_password

# Redis password (required in production — used by redis-server --requirepass)
REDIS_PASSWORD=change_me_strong_password

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  Self-hosted Supabase  (per-app database — Base44-style)                    │
# │                                                                             │
# │  Each app a user builds in Prompify gets its own isolated schema in this    │
# │  Supabase instance.  The Admin Panel → Data section auto-connects using     │
# │  these credentials — users never see or enter them.                         │
# │                                                                             │
# │  Leave all three blank to disable platform-mode; the Data section will      │
# │  show a manual connect form so power users can bring their own Supabase.   │
# │                                                                             │
# │  How to get these values:                                                   │
# │    Cloud Supabase  → supabase.com → Project Settings → API                 │
# │    Self-hosted     → run generate-keys.js (see supabase/README) and copy   │
# │                       ANON_KEY / SERVICE_ROLE_KEY from supabase/.env        │
# └─────────────────────────────────────────────────────────────────────────────┘
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Snapshot blob storage (S3-compatible — Huawei OBS) ──────────────────────────
# Content-addressed storage for codebase snapshots (ARCHITECTURE-v2 Phase 1).
# Consumed by app/lib/.server/storage.ts. The bucket MUST be private.
# Required before Phase 1 Day 5 (first live presigned-URL upload); not needed for tests.
S3_ENDPOINT=https://obs.ap-southeast-3.myhuaweicloud.com
S3_REGION=ap-southeast-3
S3_BUCKET=prompify-snapshots
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Used for email verification, welcome, password reset, chat invitations,
# token carry-over warnings, and inactivity win-back nudges.
# Unset = emails are logged to the console instead of sent (safe for local dev).
# FROM_EMAIL must be on a domain verified in the Resend account, or every send 403s.
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Prompify

# ── LLM / AI providers ─────────────────────────────────────────────────────────
# Set only the providers you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPEN_ROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
HuggingFace_API_KEY=
TOGETHER_API_KEY=
TOGETHER_API_BASE_URL=
HYPERBOLIC_API_KEY=
HYPERBOLIC_API_BASE_URL=

# Alibaba Cloud DashScope / Qwen (OpenAI-compatible)
DASHSCOPE_API_KEY=
# International: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China:         https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_BASE_URL=

# Local models
OLLAMA_API_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_API_BASE_URL=
OPENAI_LIKE_API_BASE_URL=
OPENAI_LIKE_API_KEY=

# AWS Bedrock
# JSON: {"region":"us-east-1","accessKeyId":"...","secretAccessKey":"..."}
AWS_BEDROCK_CONFIG=

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Used for git clone, push, and GitHub authentication inside generated apps.
# GITHUB_TOKEN is the primary server-side token (used by /api/github-template).
# Falls back to VITE_GITHUB_ACCESS_TOKEN if unset.
GITHUB_TOKEN=
VITE_GITHUB_ACCESS_TOKEN=
VITE_GITHUB_TOKEN_TYPE=classic

# Public URL injected into deployed apps (used by /api/deploy)
PROMPIFY_PUBLIC_URL=https://prompify.com

# ── Cron ──────────────────────────────────────────────────────────────────────
# Authenticates scheduled jobs (/api/cron/sleep-check, /api/cron/gc, /api/metrics).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Data API ──────────────────────────────────────────────────────────────────
# Signs bearer tokens for generated-app data proxy access (/api/data/token).
# Falls back to JWT_SECRET if unset — MUST be a dedicated secret in production.
DATA_API_SECRET=

# ── Site identity ─────────────────────────────────────────────────────────────
# Canonical domain. Used for robots.txt, sitemap.xml, and JSON-LD on /about.
SITE_URL=https://prompify.com

# ── KooGallery (optional) ──────────────────────────────────────────────────────
KOOGALLERY_ACCESS_ID=
KOOGALLERY_ACCESS_KEY=
KOOGALLERY_API_BASE_URL=https://api.koogallery.com
KOOGALLERY_ENABLED=false

# ── UI feature flags ───────────────────────────────────────────────────────────
VITE_LOG_LEVEL=info
DISABLE_DYNAMIC_MODELS=false
VITE_HIDE_IMPORT_CHAT=false
VITE_HIDE_IMPORT_FOLDER=false
VITE_HIDE_GIT_CLONE=false
VITE_HIDE_SETTINGS=false
VITE_DISABLE_FRAMEWORK=false
VITE_DISABLE_LANGUAGE=false
VITE_DISABLE_CSS_FRAMEWORK=false
VITE_DISABLE_DATABASE=false

# ── Codebase snapshots (refresh persistence) ──────────────────────────────
# VITE_SNAPSHOTS_ENABLED is a BUILD-TIME Vite var — it is inlined into the
# client bundle at `remix vite:build` time. If unset, the snapshot save is a
# silent no-op and manual file edits do NOT survive a refresh. MUST be 'true'
# in any environment that builds the client (Docker build, CI). The Dockerfile
# declares it as a build ARG defaulting to 'true'.
VITE_SNAPSHOTS_ENABLED=true
# SNAPSHOTS_ENABLED (no VITE_ prefix) gates the SERVER-side snapshot endpoints
# (dedup / upload-url / version save / load) + the GC cron. Runtime only.
SNAPSHOTS_ENABLED=true

# Ollama context window size (optional — for large context models)
DEFAULT_NUM_CTX=
