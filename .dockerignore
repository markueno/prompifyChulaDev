# Ignore Git and GitHub files
.git
.github/

# Ignore Husky configuration files
.husky/

# Ignore documentation and metadata files
CONTRIBUTING.md
LICENSE
README.md

# Ignore environment examples and sensitive info
#.env
*.local
*.example

# Ignore node modules, logs and cache files
**/*.log
**/node_modules
**/dist
**/build
**/.cache
logs
dist-ssr
.DS_Store
.env
.env.*

# Ignore pnpm virtual store (hundreds of MB)
.pnpm-store/

# Ignore test and coverage output
coverage/
test-results/

# Ignore temp directories
tmp/

# Ignore Docker Compose files (not needed in image)
docker-compose*.yaml

# Ignore Dockerfiles and IDE configs
Dockerfile
.vscode/
.idea/
